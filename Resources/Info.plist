<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CFBundleName is the label macOS shows in System Settings > Privacy & Security >
	     Speech Recognition. Keep it identical to the binary name so the toggle is
	     recognisable. -->
	<key>CFBundleName</key>
	<string>apple-voicememos-mcp</string>
	<key>CFBundleIdentifier</key>
	<string>codes.eneko.apple-voicememos-mcp</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.5</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- recording_transcribe runs SFSpeechRecognizer with requiresOnDeviceRecognition,
	     so no audio leaves the machine — but the permission is still the same one, and
	     without this key macOS denies it with no prompt. Key name verified against the
	     tccd binary on macOS 26.5. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lets Claude transcribe your voice recordings on this Mac. Recognition is forced on-device, so the audio is never sent to Apple.</string>

	<!-- Declared, not currently exercised. Voice Memos is reachable only through the
	     Shortcuts app, which is driven by Apple events, and the App Intents check
	     recorded in verification.md may yet be worth revisiting for the one thing
	     the filesystem cannot supply: the in-app folder a recording belongs to. TCC
	     denies an undeclared Apple event with no prompt at all, so declaring it now
	     costs a string and saves a silent failure later. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Lets this server ask the Shortcuts app about your voice recordings. Nothing is sent anywhere and no recording is changed.</string>
</dict>
</plist>
